SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase / PostgreSQL. Encodez les caracteres speciaux du mot de passe dans l'URL
# Exemple: @ devient %40. DATABASE_URL sert a l'app, DIRECT_URL aux migrations.
DATABASE_URL=
DIRECT_URL=

# Ancien mode PostgreSQL separe. L'API demarre en SQLite si toutes les variables DB sont vides.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
