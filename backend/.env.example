SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://couture-web.onrender.com

# Supabase / PostgreSQL. Encodez les caracteres speciaux du mot de passe dans l'URL
# Exemple: @ devient %40. DATABASE_URL sert a l'app, DIRECT_URL aux migrations.
DATABASE_URL=
DIRECT_URL=

# Ancien mode PostgreSQL separe. L'API demarre en SQLite si toutes les variables DB sont vides.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Stockage persistant des images sur Cloudinary. Si ces trois valeurs sont
# presentes, Django envoie les ImageField vers Cloudinary au lieu de backend/media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_BASE_FOLDER=
CLOUDINARY_UPLOAD_FOLDER=couture
